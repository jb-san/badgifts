---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;

const description = "That page is not on the Bad Gifts shelf.";
---

<BaseLayout title="Page not found" description={description}>
  <article class="page">
    <p class="stamp">404</p>
    <h1>This aisle does not exist.</h1>
    <p class="lede">The link wandered off. The gifts that do exist are back on the shelf.</p>
    <p>
      <a class="btn" href="/">Back to the aisle</a>
    </p>
  </article>
</BaseLayout>
