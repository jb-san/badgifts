---
import "@fontsource/lilita-one/latin-400.css";
import "@fontsource/outfit/latin-400.css";
import "@fontsource/outfit/latin-700.css";
import "@fontsource/outfit/latin-800.css";
import "../styles/global.css";
import { jsonLdScript, siteName, socialImage } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  fullTitle?: string;
  ogType?: "website" | "article";
  image?: string;
  imageAlt?: string;
  jsonLd?: unknown;
}

const {
  title,
  description,
  fullTitle,
  ogType = "website",
  image,
  imageAlt = "Bad Gifts wordmark on a cream background with a yellow sticker.",
  jsonLd,
} = Astro.props;

if (!Astro.site) {
  throw new Error("Set site in astro.config.mjs before building.");
}

const documentTitle = fullTitle ?? `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = socialImage(image, Astro.site);
const usingDefaultOg = ogImage.endsWith("/og.png");
const path = Astro.url.pathname;

function isCurrent(href: string) {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(href);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1a1024" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={usingDefaultOg ? "Bad Gifts wordmark on a cream background with a yellow sticker." : imageAlt} />
    {usingDefaultOg && <meta property="og:image:width" content="1200" />}
    {usingDefaultOg && <meta property="og:image:height" content="630" />}
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLdScript(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {
      import.meta.env.DEV && (
        <p class="dev-banner">
          Dev preview: draft examples are visible here. Production builds leave them out.
        </p>
      )
    }
    <header class="site-header">
      <div class="hazard" aria-hidden="true"></div>
      <div class="wrap header-inner">
        <a class="logo" href="/">Bad <span>Gifts</span></a>
        <nav class="nav" aria-label="Primary">
          <a href="/" aria-current={isCurrent("/") ? "page" : undefined}>The aisle</a>
          <a href="/tags/" aria-current={isCurrent("/tags/") ? "page" : undefined}>Tags</a>
          <a href="/about/" aria-current={isCurrent("/about/") ? "page" : undefined}>About</a>
          <a href="/disclosure/" aria-current={isCurrent("/disclosure/") ? "page" : undefined}>
            Disclosure
          </a>
        </nav>
      </div>
    </header>
    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div>
          <p>Bad Gifts points at funny, weird, and gag gifts. We are not the merchant.</p>
          <p>
            Some links are affiliate links. If you buy, we may earn a commission.{" "}
            <a href="/disclosure/">Read the disclosure</a>.
          </p>
        </div>
        <p>badgifts.shop</p>
      </div>
    </footer>
  </body>
</html>
